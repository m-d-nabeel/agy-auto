#!/usr/bin/env bash
#
# agy-auto — run agy interactively; auto-send "continue" on recoverable errors.
#
#   agy-auto [agy args...]   start (or reattach) — this is all you normally run
#   agy-auto --status        show session + watcher state
#   agy-auto --log           tail the decision log
#   agy-auto --stop          kill session and watcher
#   agy-auto --dry-run ...   detect and log, but never inject (trial run)
#
# You use agy completely normally. A background watcher reads the rendered pane
# text and types "continue" only when a known error has left the agent stopped.
# No TUI calibration: "idle" is inferred from screen stability.
#
# Three classes trigger a retry:
#   FAST  — any crash with an Error ID (or the hand-listed PATTERNS). Retry
#           as soon as the TUI settles.
#   SLOW  — "verifying your account", rate limits. The server told us to
#           wait, so hold SLOW_WAIT seconds from when the message appeared.
#   STALL — the spinner (the animated "still working" glyph every TUI shows)
#           is on screen but hasn't advanced a single frame in STALL_SECS,
#           and the box is empty. A finished/idle screen has no spinner, so
#           this can't fire on you just taking your time to respond.
#           Escape is sent before "continue" to clear the frozen state.
# All escalate: each retry without recovery doubles the backoff.
#
# If keyboard input ever fully stops responding (e.g. after navigating an
# overlay) with no error text and no spinner, none of the above can detect
# it — deliberately: there's no reliable signal to trigger on without risking
# a false positive on a session that's simply waiting on you. Closing the
# terminal does NOT fix this; the tmux session survives and you'll reattach
# to the exact same wedged state. Recover manually instead:
#   agy-auto --stop && agy-auto --continue [your usual flags]
# --continue resumes from agy's own persisted conversation state, not tmux,
# so this is safe even though it kills the stuck session outright.
#
set -euo pipefail

# Needs the printf '%()T' strftime builtin (bash >=4.2). macOS ships bash 3.2
# by default - install a newer one (e.g. `brew install bash`) and run this
# with that binary instead.
if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 2) )); then
  echo "agy-auto: needs bash >= 4.2, found ${BASH_VERSION}" >&2
  exit 1
fi

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/agy-auto.conf"
[[ -r "$CONF" ]] && . "$CONF"

# ---- FAST: retry once the TUI is idle -------------------------------------
PATTERNS="${AGY_AUTO_PATTERNS:-$(cat <<'EOF'
network (issue|error) connecting to the server
agent execution terminated due to error
EOF
)}"

# ---- SLOW: server asked us to wait; hold SLOW_WAIT before retrying ---------
SLOW_PATTERNS="${AGY_AUTO_SLOW_PATTERNS:-$(cat <<'EOF'
verifying your account
verifying your account eligibility
please try again shortly
rate limit
overloaded
EOF
)}"

POLL="${AGY_AUTO_POLL:-0.4}"
STALL_SECS="${AGY_AUTO_STALL_SECS:-60}"    # box empty + zero screen change this
                                           # long after the agent had the turn
                                           # = silently hung, not "your move"
STABLE_TICKS="${AGY_AUTO_STABLE:-4}"
IDLE_TIMEOUT="${AGY_AUTO_IDLE_TIMEOUT:-120}"
COOLDOWN="${AGY_AUTO_COOLDOWN:-15}"        # base backoff, doubles per retry
MAX_BACKOFF="${AGY_AUTO_MAX_BACKOFF:-300}" # backoff ceiling
SLOW_WAIT="${AGY_AUTO_SLOW_WAIT:-60}"      # min hold for SLOW-class messages
MAX_STREAK="${AGY_AUTO_MAX_STREAK:-8}"
RECOVER_SECS="${AGY_AUTO_RECOVER_SECS:-90}" # clean time that resets the streak
SCROLLBACK="${AGY_AUTO_SCROLLBACK:-80}"
CONFIRM_SECS="${AGY_AUTO_CONFIRM_SECS:-20}" # max wait after sending to confirm it worked
HEALTH="${AGY_AUTO_HEALTH:-1}"             # consult agy's own log before injecting
# How far back in agy's log counts as "recent work". Defaults to STALL_SECS
# because the question being asked is exactly "was the backend alive during
# the window in which the screen appeared frozen?" — so the two must match.
# Backtested against 11 real stalls: 60s scores 10/11; 75s misclassifies all
# six genuine hangs as working and would disable hang recovery entirely.
WORK_WINDOW="${AGY_AUTO_WORK_WINDOW:-$STALL_SECS}"
CONTINUE_TEXT="${AGY_AUTO_CONTINUE_TEXT:-continue}"
# ---------------------------------------------------------------------------

RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}/agy-auto"
mkdir -p "$RUN_DIR"

# Braille spinner glyphs (U+2800-28FF) as a raw UTF-8 byte range, matched under
# the C locale with plain -E — portable to BSD/macOS grep, unlike \x{...}
# codepoint escapes which need PCRE (-P, GNU/Linux-only).
SPINNER_BYTES=$'\xe2[\xa0-\xa3][\x80-\xbf]'

SESSION="agy_$(basename "$PWD" | tr -c 'A-Za-z0-9' _)_$(printf %s "$PWD" | cksum | cut -d' ' -f1)"
LOGF="$RUN_DIR/$SESSION.log"

log()    { printf '%(%H:%M:%S)T %s\n' -1 "$*" >>"$LOGF"; }
alive()  { tmux has-session -t "$SESSION" 2>/dev/null; }
screen() { tmux capture-pane -p -J -S "-$SCROLLBACK" -t "$SESSION" 2>/dev/null; }
to_re()  { printf '%s' "$1" | grep -v '^[[:space:]]*$' | paste -sd'|'; }

# --- agy's own log: the only signal that tells truth about what it's doing ----
# The rendered screen cannot distinguish "hung" from "working but not painting"
# from "network down" — all look identical. agy's internal log distinguishes
# all of them, so we consult it before typing anything into a live session.

# Locate the log the RUNNING agy has open. Deliberately not "newest by mtime":
# agy rotates its log on restart, and mtime picks the wrong file the moment it
# does (observed live). The process's own fd table is always correct.
agy_log() {
  local pid fd
  pid="$(tmux list-panes -t "$SESSION" -F '#{pane_pid}' 2>/dev/null | head -1)" || return 1
  [[ -n "$pid" && -d "/proc/$pid/fd" ]] || return 1
  fd="$(ls -l "/proc/$pid/fd" 2>/dev/null \
        | grep -oE '/[^ ]*antigravity-cli/log/[^ ]+\.log' | head -1)"
  [[ -n "$fd" && -r "$fd" ]] || return 1
  printf '%s' "$fd"
}

# Report what agy is actually doing, as "<work_state> <stream_state>":
#   work:   WORKING | SILENT | NET_FAIL | UNKNOWN
#   stream: live | dead        (the agent_state feed that drives the spinner)
# UNKNOWN means we could not read the log — callers must then behave exactly
# as they did before this check existed, so a missing log can never make
# things worse than not having the check at all.
agy_health() {
  local alog now work net tail_lines died started
  alog="$(agy_log)" || { printf 'UNKNOWN live'; return; }
  tail_lines="$(tail -n 4000 "$alog" 2>/dev/null)" || { printf 'UNKNOWN live'; return; }
  [[ -n "$tail_lines" ]] || { printf 'UNKNOWN live'; return; }
  now="$(printf '%(%H:%M:%S)T' -1)"

  # Only lines within WORK_WINDOW seconds count. Housekeeping noise
  # (credit polls, telemetry, config warnings) fires constantly in every
  # state, so "the log changed" is meaningless — only real work counts.
  local recent
  recent="$(awk -v now="$now" -v win="$WORK_WINDOW" '
    function secs(t,  p) { split(t, p, ":"); return p[1]*3600 + p[2]*60 + p[3] }
    BEGIN { n = secs(now) }
    match($0, /^[IWEF][0-9]+ ([0-9]{2}:[0-9]{2}:[0-9]{2})/, m) {
      s = secs(m[1])
      d = n - s
      if (d < 0) d += 86400          # crossed midnight
      if (d <= win) print
    }' <<<"$tail_lines" 2>/dev/null)"

  work=SILENT
  if grep -qE 'streamGenerateContent|run\.go:[0-9]+\] Run: attempt|Forwarding user message' <<<"$recent"; then
    work=WORKING
  fi
  # Network failure outranks: the message was accepted and instantly failed,
  # so more injections cannot help until connectivity returns.
  if grep -qE 'agent executor error|generating and executing: request failed' <<<"$recent"; then
    work=NET_FAIL
  fi

  # The agent_state feed is latched-dead if its last failure came after the
  # last start. While dead the spinner is stale, so it must not be trusted.
  died="$(grep -nE 'Conversation update stream .* failed' <<<"$tail_lines" | tail -1 | cut -d: -f1)"
  started="$(grep -nE 'Starting conversation update stream' <<<"$tail_lines" | tail -1 | cut -d: -f1)"
  if [[ -n "$died" && ( -z "$started" || "$died" -gt "$started" ) ]]; then
    printf '%s dead' "$work"
  else
    printf '%s live' "$work"
  fi
}
# Extract candidate error lines immediately preceding the active prompt divider.
# If the user is currently typing, or if normal output precedes the prompt, outputs nothing.
live_error_tail() {
  awk '
  /^[[:space:]]*$/ { next }
  /[─\-]{10,}/ { div[num_div++] = NR; lines[NR] = $0; next }
  { lines[NR] = $0 }
  END {
    if (num_div < 2) exit 0
    top_div = div[num_div - 2]
    bot_div = div[num_div - 1]

    # Check prompt between dividers
    prompt = ""
    for (i = top_div + 1; i < bot_div; i++) {
      if (lines[i] != "") prompt = prompt lines[i] " "
    }
    sub(/^[[:space:]]+/, "", prompt)
    sub(/[[:space:]]+$/, "", prompt)

    # If prompt contains user text (not empty and not bare ">"), user is typing -> do not touch
    if (prompt != ">" && prompt != "") {
      exit 0
    }

    # Grab the last 2 non-empty lines immediately above the top divider
    count = 0
    for (i = top_div - 1; i >= 1 && count < 2; i--) {
      if (lines[i] != "") {
        cand[count++] = lines[i]
      }
    }
    for (i = count - 1; i >= 0; i--) {
      print cand[i]
    }
  }
  '
}
# True iff the prompt box between the last two dividers is empty (bare ">").
# Non-empty means you're mid-typing — never touch that.
prompt_empty() {
  awk '
  /^[[:space:]]*$/ { next }
  /[─\-]{10,}/ { div[num_div++] = NR; lines[NR] = $0; next }
  { lines[NR] = $0 }
  END {
    if (num_div < 2) exit 1
    top_div = div[num_div - 2]; bot_div = div[num_div - 1]
    prompt = ""
    for (i = top_div + 1; i < bot_div; i++) { if (lines[i] != "") prompt = prompt lines[i] " " }
    sub(/^[[:space:]]+/, "", prompt); sub(/[[:space:]]+$/, "", prompt)
    exit (prompt == ">" || prompt == "") ? 0 : 1
  }
  '
}
# True iff a braille spinner glyph (U+2800-28FF) is visible — the generic
# "agent is actively working" indicator every one of these TUIs uses,
# regardless of the word next to it ("Working", "Loading"...). Callers must
# pass an already divider-scoped region (live_error_tail's output), not the
# raw pane: a blind tail of the whole capture keeps "seeing" an old frozen
# spinner line long after real recovery, since a short session's entire
# transcript can fit inside a fixed trailing-line window.
spinner_active() { LC_ALL=C grep -qE "$SPINNER_BYTES"; }
# Drop any line carrying the spinner glyph before comparing screens for
# staleness: the animation is a client-side heartbeat that keeps ticking on
# its own even after generation has actually died, so by itself it must never
# count as "the screen changed." Only real content growing counts.
strip_spinner() { LC_ALL=C grep -vE "$SPINNER_BYTES"; }

# tmux defaults degrade a modern terminal: modified keys (Shift+Enter) lose
# their modifier and arrive as a bare CR, and truecolor is quantised. Advertise
# what the outer terminal can actually do. Server-scoped, applied idempotently.
tmux_tune() {
  local t="${TERM:-xterm}"
  tmux set-option -s  extended-keys always         2>/dev/null || true
  tmux set-option -s  extended-keys-format csi-u  2>/dev/null || true
  tmux set-option -s  escape-time 10              2>/dev/null || true
  # Actually idempotent: -sa only appends, so calling this more than once
  # (every agy-auto invocation does) would otherwise grow this list forever.
  # Clear back to tmux's own built-ins first, then rebuild fresh.
  tmux set-option -su terminal-features 2>/dev/null || true
  tmux set-option -sa terminal-features "xterm*:extkeys:RGB:clipboard:focus:title" 2>/dev/null || true
  tmux set-option -sa terminal-features "*kitty*:extkeys:RGB:clipboard:focus:title" 2>/dev/null || true
  tmux set-option -sa terminal-features "*:extkeys" 2>/dev/null || true
  [[ "${COLORTERM:-}" == truecolor || "${COLORTERM:-}" == 24bit ]] &&
    tmux set-option -sa terminal-features '*:RGB' 2>/dev/null || true
  tmux set-option -g  allow-passthrough on 2>/dev/null || true
  tmux set-option -g  aggressive-resize on  2>/dev/null || true
  tmux set-option -g  history-limit 50000   2>/dev/null || true
  tmux bind-key -n S-Enter send-keys Escape "[13;2u" 2>/dev/null || true
}

watch_loop() {
  set +e +o pipefail   # a poll loop must never die on a transient non-zero
  local dry="$1"
  local prev="" stable=0 streak=0 clean=0 last=0 last_sig="" first_seen=0
  local scr content tailtxt fast slow hits sig now waited need class err_id is_stall fixed
  local scr2 tailtxt2 csettle cprev cticks ccontent confirm_max
  local health hwork hstream send_escape
  local fast_re slow_re clean_needed stall_ticks
  fast_re="$(to_re "$PATTERNS")"
  slow_re="$(to_re "$SLOW_PATTERNS")"
  clean_needed=$(awk -v p="$POLL" -v s="$RECOVER_SECS" 'BEGIN{n=int(s/p); print (n<1?1:n)}')
  stall_ticks=$(awk -v p="$POLL" -v s="$STALL_SECS" 'BEGIN{n=int(s/p); print (n<1?1:n)}')

  log "watcher start (dry=$dry)"
  log "  fast: $fast_re"
  log "  slow: $slow_re"
  log "  stall: spinner frozen (box empty, unchanged) for ${STALL_SECS}s"

  while alive; do
    sleep "$POLL"
    scr="$(screen)" || continue
    content="$(strip_spinner <<<"$scr" || true)"

    if [[ "$content" == "$prev" ]]; then stable=$((stable + 1)); else stable=0; prev="$content"; fi

    tailtxt="$(live_error_tail <<<"$scr" || true)"
    err_id=""; fast=""; slow=""; is_stall=0
    if [[ -n "$tailtxt" ]]; then
      # Error ID is the real generic signal: agy stamps one on every crash,
      # regardless of wording. Check it first so unlisted error text still
      # gets caught instead of relying on PATTERNS staying up to date.
      err_id="$(grep -Eia 'error id:[[:space:]]*[0-9a-f-]+' <<<"$tailtxt" | tail -1 || true)"
      fast="$(grep -Eia "$fast_re" <<<"$tailtxt" | tail -1 || true)"
      slow="$(grep -Eia "$slow_re" <<<"$tailtxt" | tail -1 || true)"
      [[ -z "$fast$slow" && -n "$err_id" ]] && fast="$err_id"
    fi
    hits="$fast$slow"

    # No error text. Still check for a silent stall: a spinner is visible
    # (the agent is supposedly still working, not waiting on you) and the
    # screen hasn't moved a single byte for STALL_SECS — the spinner itself
    # froze. A normal "task's done, your turn" screen has no spinner at all,
    # so it can never trip this no matter how long it sits idle.
    if [[ -z "$hits" ]] && (( stable >= stall_ticks )) && spinner_active <<<"$tailtxt" && prompt_empty <<<"$scr"; then
      is_stall=1
      hits="STALL:$(LC_ALL=C grep -E "$SPINNER_BYTES" <<<"$tailtxt" | tail -1)"
    fi

    if [[ -z "$hits" ]]; then
      clean=$((clean + 1))
      first_seen=0
      if (( clean >= clean_needed )) && (( streak > 0 )); then
        log "recovered — streak reset"; streak=0; clean=0; last_sig=""
      fi
      continue
    fi

    clean=0
    now="$(printf '%(%s)T' -1)"

    # Error ID (already captured above) and previous continue count ensure a
    # genuinely new failure is distinguishable from the same one still on screen.
    sig="$(printf '%s\n%s\n%s' "$hits" "$err_id" "$(grep -c '> continue' <<<"$scr")" | cksum)"

    # Deduplication: If we ALREADY injected continue for this error attempt,
    # DO NOT inject again! Wait for agy to either recover or fail with a new attempt.
    if [[ "$sig" == "$last_sig" ]]; then
      continue
    fi

    (( first_seen == 0 )) && { first_seen="$now"; log "detected: $(head -1 <<<"$hits")"; }

    if (( is_stall )); then class=stall
    elif [[ -n "$slow" ]]; then class=slow
    else class=fast; fi

    need=$(awk -v c="$COOLDOWN" -v s="$streak" -v m="$MAX_BACKOFF" \
           'BEGIN{v=c*(2^s); print (v>m?m:v)}')
    if [[ "$class" == slow ]] && (( need < SLOW_WAIT )); then need="$SLOW_WAIT"; fi

    if [[ "$class" == slow ]]; then
      (( now - first_seen < need )) && continue
    fi
    (( last > 0 && now - last < need )) && continue

    if (( streak >= MAX_STREAK )); then
      tmux display-message -d 8000 -t "$SESSION" \
        "agy-auto paused: $MAX_STREAK retries without recovery — take over." 2>/dev/null || true
      log "PAUSED after $MAX_STREAK retries without recovery"
      streak=0; last="$now"; first_seen="$now"; last_sig="$sig"
      continue
    fi

    # Let the TUI settle before typing into it.
    waited=0
    while (( stable < STABLE_TICKS )) && alive; do
      sleep "$POLL"
      scr="$(screen)" || break
      content="$(strip_spinner <<<"$scr" || true)"
      if [[ "$content" == "$prev" ]]; then stable=$((stable + 1)); else stable=0; prev="$content"; fi
      waited=$((waited + 1))
      (( waited > IDLE_TIMEOUT * 2 )) && { log "idle wait timed out; sending anyway"; break; }
    done
    alive || break

    # Final safety check: re-verify the condition is STILL true, not resolved
    # while we waited for the TUI to settle. Compare spinner-stripped content
    # here too — the glyph alone changing must not look like "it recovered."
    if (( is_stall )); then
      if [[ "$(strip_spinner < <(screen))" != "$content" ]]; then
        log "stall cleared while waiting for idle — aborting injection"
        continue
      fi
    else
      tailtxt="$(live_error_tail <<<"$scr" || true)"
      # Same match logic the initial detection used, Error ID fallback
      # included — otherwise an error caught only via Error ID can never
      # pass this recheck and would spin here forever without ever sending.
      if [[ -z "$tailtxt" ]] || { ! grep -Eqia "$fast_re|$slow_re" <<<"$tailtxt" && \
           ! grep -Eqia 'error id:[[:space:]]*[0-9a-f-]+' <<<"$tailtxt"; }; then
        log "error cleared or superseded while waiting for idle — aborting injection"
        continue
      fi
    fi

    if [[ "$dry" == 1 ]]; then
      log "DRY-RUN would send '$CONTINUE_TEXT' [$class, waited ${need}s, streak $((streak+1))]"
      last="$now"; last_sig="$sig"; streak=$((streak + 1)); stable=0; first_seen=0
      continue
    fi

    # One more check, as close to the actual keystrokes as this polling
    # model allows: never type over you. This can't be made airtight — two
    # independent writers with no locking always leaves *some* window — but
    # a fresh check right here, instead of trusting the diff from a moment
    # ago, shrinks that window to as small as this script can make it.
    scr="$(screen)" || scr=""
    if ! prompt_empty <<<"$scr"; then
      log "you're typing — aborting injection"
      continue
    fi

    # Ask agy what it's actually doing before typing at it. A frozen spinner
    # means nothing on its own: it can mean the agent hung, OR that the
    # agent_state feed died and the spinner is simply stale while the model
    # keeps working. Injecting in the latter case sends Escape, which is
    # agy's cancel action — destroying a live response.
    send_escape=$is_stall
    if (( HEALTH )); then
      health="$(agy_health)"; hwork="${health%% *}"; hstream="${health##* }"
      case "$hwork" in
        WORKING)
          if (( is_stall )); then
            log "backend is working (stream=$hstream) — spinner is stale, not injecting"
            stable=0; first_seen=0
            continue
          fi ;;
        NET_FAIL)
          # The message would be accepted and instantly fail, so there is
          # nothing to gain by sending it. Hold off via `last` (which enforces
          # the backoff) but deliberately do NOT set last_sig: the condition
          # must stay eligible to retrigger, otherwise an unchanged screen
          # would dedupe this forever and we'd never retry once the network
          # came back. Observed live: a 12-minute outage that self-recovered.
          log "network failing (stream=$hstream) — deferring [$class]"
          last="$now"; stable=0; first_seen=0
          continue ;;
        SILENT)
          : ;;   # genuinely hung — proceed, Escape is warranted
        UNKNOWN)
          : ;;   # no log readable: behave exactly as before this check existed
      esac
      [[ "$hstream" == dead ]] && log "note: agent_state stream is dead — spinner unreliable"
    fi

    if (( send_escape )); then
      tmux send-keys -t "$SESSION" Escape
      sleep 0.3
    fi
    tmux send-keys -t "$SESSION" -l "$CONTINUE_TEXT"
    sleep 0.2
    tmux send-keys -t "$SESSION" Enter
    log "sent '$CONTINUE_TEXT' [$class, backoff ${need}s, streak $((streak+1))]"

    # A continue that actually clears the condition was a fresh, distinct
    # incident — not a repeat of one the last continue failed to fix — so it
    # shouldn't inherit escalated backoff from an earlier, unrelated recovery.
    # This needs the screen to genuinely RE-SETTLE, not just differ once: a
    # persistent, not-actually-transient problem makes every retry re-freeze
    # on a *slightly* different render each time — a one-shot byte diff calls
    # that "fixed" every single time, which lets the streak reset forever and
    # the MAX_STREAK circuit breaker never trips.
    # So: wait for it to settle again, then check whether the state it
    # settled INTO is itself a known-bad one (error text, or frozen spinner).
    # Sustained activity with no re-freeze for the whole window also counts
    # as fixed — it's clearly not stuck.
    fixed=0
    csettle=0; cprev=""; cticks=0
    confirm_max=$(awk -v p="$POLL" -v c="$CONFIRM_SECS" 'BEGIN{n=int(c/p); print (n<1?1:n)}')
    while (( cticks < confirm_max )); do
      sleep "$POLL"
      cticks=$((cticks + 1))
      scr2="$(screen)" || continue
      ccontent="$(strip_spinner <<<"$scr2" || true)"
      if [[ "$ccontent" == "$cprev" ]]; then csettle=$((csettle + 1)); else csettle=0; cprev="$ccontent"; fi

      tailtxt2="$(live_error_tail <<<"$scr2" || true)"
      if [[ -n "$tailtxt2" ]] && { grep -Eqia "$fast_re|$slow_re" <<<"$tailtxt2" || \
           grep -Eqia 'error id:[[:space:]]*[0-9a-f-]+' <<<"$tailtxt2"; }; then
        break   # a real error showed up — definitely not fixed
      fi

      if (( csettle >= STABLE_TICKS )); then
        if spinner_active <<<"$tailtxt2" && prompt_empty <<<"$scr2"; then
          break   # settled right back into a frozen-spinner state — not fixed
        fi
        fixed=1; break   # settled into something that isn't a stall — genuinely fixed
      fi
    done
    (( cticks >= confirm_max )) && fixed=1   # stayed actively changing the whole window
    if (( fixed )); then
      log "$class fix confirmed — streak reset"
      last="$now"; last_sig="$sig"; streak=0; stable=0; first_seen=0
      continue
    fi

    last="$now"; last_sig="$sig"; streak=$((streak + 1)); stable=0; first_seen=0
  done
  log "watcher exit"
}

case "${1:-}" in
  --watch)
    while alive; do
      watch_loop "${2:-0}"
      alive || break
      log "watcher exited unexpectedly — restarting in 2s"
      sleep 2
    done
    log "watcher stopped (session gone)"
    exit 0 ;;
  --status)
    alive && echo "session $SESSION: running" || echo "session $SESSION: not running"
    if pgrep -af 'agy-auto --watch' >/dev/null; then
      echo "watcher: running  ($(pgrep -f 'agy-auto --watch' | tr '\n' ' '))"
    else
      echo "watcher: NOT RUNNING"
    fi
    printf 'extended-keys: %s (%s)   TERM=%s\n' \
      "$(tmux show-options -sqv extended-keys 2>/dev/null)" \
      "$(tmux show-options -sqv extended-keys-format 2>/dev/null)" "${TERM:-?}"
    [[ -r "$LOGF" ]] && { echo "--- recent ---"; tail -n 10 "$LOGF"; }
    exit 0 ;;
  --log)     tail -n 40 -f "$LOGF" 2>/dev/null || echo "no log yet"; exit 0 ;;
  --stop)    tmux kill-session -t "$SESSION" 2>/dev/null && echo stopped || echo "not running"; exit 0 ;;
  --dry-run) DRY=1; shift ;;
  *)         DRY=0 ;;
esac

command -v tmux >/dev/null || { echo "agy-auto: tmux is required" >&2; exit 1; }
command -v agy  >/dev/null || { echo "agy-auto: agy not on PATH" >&2; exit 1; }

# Resolve our own path without realpath (not on macOS/BSD by default): $0 as
# invoked, made absolute if relative, or looked up on PATH if it's a bare name.
case "$0" in
  /*) SELF="$0" ;;
  */*) SELF="$PWD/$0" ;;
  *) SELF="$(command -v "$0")" ;;
esac

if ! alive; then
  : >"$LOGF"
  tmux start-server 2>/dev/null || true
  tmux_tune
  tmux new-session -d -s "$SESSION" -c "$PWD" -x "$(tput cols)" -y "$(tput lines)" "agy $*"
  tmux_tune
  tmux set-option -t "$SESSION" -q status off
  tmux set-option -t "$SESSION" -q window-size latest
  # nohup+disown instead of setsid (util-linux, not on macOS/BSD): both just
  # need the watcher to survive this shell exiting once you detach.
  nohup "$SELF" --watch "$DRY" >/dev/null 2>&1 </dev/null &
  disown
  echo "agy-auto: watching (fast retry + slow backoff)   'agy-auto --log' to inspect"
else
  tmux_tune
fi

if [[ -n "${TMUX:-}" ]]; then tmux switch-client -t "$SESSION"
else tmux attach-session -t "$SESSION"; fi

if alive; then
  echo "agy-auto: detached — session still running. Re-run here to reattach."
else
  echo "agy-auto: agy exited."
fi
